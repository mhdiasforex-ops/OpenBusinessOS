# ============================================================
# OpenBusinessOS — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values for your setup.
#   cp .env.example .env
# ============================================================

# --- Application ---
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbusinessos?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio123
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=openbusinessos
MINIO_USE_SSL=false

# --- JWT ---
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- NextAuth ---
NEXTAUTH_SECRET=change-me-to-a-secure-random-string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- AI (Optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Monitoring (Optional) ---
SENTRY_DSN=

# --- Log Level ---
LOG_LEVEL=debug
