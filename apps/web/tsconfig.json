{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@openbusinessos/shared-types": [
        "../../packages/shared-types/src"
      ],
      "@openbusinessos/event-definitions": [
        "../../packages/event-definitions/src"
      ],
      "@openbusinessos/utils": [
        "../../packages/utils/src"
      ]
    },
  "noEmit": true,
 "skipLibCheck": true,
 "esModuleInterop": true,
 "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}