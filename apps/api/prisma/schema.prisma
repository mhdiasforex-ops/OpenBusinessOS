// ============================================================
// OpenBusinessOS — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Niche {
  RETAIL
  ECOMMERCE
  SERVICES
  FOOD
  PROFESSIONAL
  CONSTRUCTION
  HEALTH
  EDUCATION
  OTHER
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  OTHER
}

enum WorkflowStepType {
  SEND_EMAIL
  SEND_WHATSAPP
  CREATE_TASK
  UPDATE_STATUS
  WEBHOOK
  AI_ACTION
  DELAY
  CONDITION
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CustomerSegment {
  VIP
  REGULAR
  NEW
  AT_RISK
  CHURNED
}

// --- Organization ---

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  niche     Niche    @default(OTHER)
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 users User[]
 roles Role[]
 products Product[]
 customers Customer[]
 transactions Transaction[]
 transactionItems TransactionItem[]
 workflows Workflow[]
 workflowSteps WorkflowStep[]
 events Event[]
 dashboards Dashboard[]

  @@index([slug])
  @@index([isActive])
  @@map("organizations")
}

// --- User ---

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  name           String
  passwordHash   String    @map("password_hash")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        UserRole[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// --- Role ---

model Role {
  id             String @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  Permission[]
  users        UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// --- Permission ---

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String
  roleId   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("permissions")
}

// --- Product ---

model Product {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  sku           String
  category      String?
  costPrice     Decimal  @map("cost_price") @db.Decimal(12, 2)
  salePrice     Decimal  @map("sale_price") @db.Decimal(12, 2)
  unit          String   @default("un")
  stockQuantity Int      @default(0) @map("stock_quantity")
  minStock      Int      @default(5) @map("min_stock")
  isActive      Boolean  @default(true) @map("is_active")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactionItems TransactionItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
  @@map("products")
}

// --- Customer ---

model Customer {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  document       String?
  segment        CustomerSegment @default(NEW)
  ltv            Decimal         @default(0) @db.Decimal(12, 2)
  totalOrders    Int             @default(0) @map("total_orders")
  lastOrderAt    DateTime?       @map("last_order_at")
  tags           String[]
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, segment])
  @@map("customers")
}

// --- Transaction ---

model Transaction {
  id             String            @id @default(cuid())
  organizationId String
  type           TransactionType
  category       String
  amount         Decimal           @db.Decimal(12, 2)
  description    String
  customerId     String?
  dueDate        DateTime          @map("due_date")
  paidAt         DateTime?         @map("paid_at")
  status         TransactionStatus @default(PENDING)
  paymentMethod  PaymentMethod?
  conciliationId String?           @map("conciliation_id")
  auditTrail     Json              @default("{}") @map("audit_trail")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id])
  items        TransactionItem[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, dueDate])
  @@index([organizationId, customerId])
  @@map("transactions")
}

// --- TransactionItem ---

model TransactionItem {
 id String @id @default(cuid())
 organizationId String
 transactionId String
 productId String
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
 transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
 product Product @relation(fields: [productId], references: [id])

 @@index([organizationId])
 @@index([transactionId])
 @@index([productId])
 @@map("transaction_items")
}

// --- Workflow ---

model Workflow {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  trigger        String
  conditions     Json            @default("{}")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([trigger])
  @@map("workflows")
}

// --- WorkflowStep ---

model WorkflowStep {
 id String @id @default(cuid())
 organizationId String
 workflowId String
 order Int
 type WorkflowStepType
 config Json @default("{}")
 fallback Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
 workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

 @@index([organizationId])
 @@index([workflowId])
 @@unique([workflowId, order])
 @@map("workflow_steps")
}

// --- Event ---

model Event {
  id String @id @default(cuid())
  organizationId String
  type String
  source String
  payload Json @default("{}")
  processedAt DateTime? @map("processed_at")
  status EventStatus @default(PENDING)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([createdAt])
  @@map("events")
}

// --- Dashboard ---

model Dashboard {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  layout         Json     @default("{}")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@map("dashboards")
}
